{
  // JSON Schema による補完とバリデーションを有効化します。
  // リポジトリのルートに kmodel.config.schema.json を配置してください。
  "$schema": "./kmodel.config.schema.json",

  // 必須: Kintone サブドメイン
  "subDomain": "YOUR_SUB_DOMAIN",

  // コード生成設定の配列
  "generates": [
    {
      // 必須: Kintone アプリID
      "appId": 111,

      // 必須: このアプリにアクセスするための API トークン
      "apiToken": "YOUR_API_TOKEN_HERE",

      // 任意: 生成言語（デフォルト: CSharp）
      // 選択肢: CSharp, Python, TypeScript, Go, Java
      "generateLanguage": "CSharp",

      // 任意: ドロップダウンなどの選択肢を enum として生成するか（デフォルト: false）
      "generateEnums": false,

      // 任意: クラス名を固定したい場合に指定（null の場合はアプリ名から自動生成）
      "className": null,

      // C# 固有オプション
      "csharp": {
        // 任意: 生成される C# クラスの名前空間（デフォルト: KintoneModels）
        "namespace": "KintoneModels.App111",

        // 任意: C# record を使用するかどうか（デフォルト: false）
        "useRecord": false,

        // 任意: partial class を生成するか（デフォルト: true）
        "usePartial": true,

        // 任意: #nullable enable を付与するか（デフォルト: true）
        "nullableEnabled": true,

        // 任意: KintoneNetLibrary 固有の属性を付与しない純粋な POCO を生成するか（デフォルト: false）
        "pureMode": false
      },

      // Python 固有オプション（generateLanguage が Python の場合に有効）
      // "python": {
      //   "moduleName": "kintone_models",
      //   "useTypeHint": true
      // },

      // ファイル出力オプション
      "fileWriter": {
        // 任意: 生成ファイルの出力先ディレクトリ（デフォルト: .）
        "outputDirectory": "./Models/App111",

        // 任意: 生成ファイルが存在する場合に上書きするか（デフォルト: false）
        "overwriteExistingFiles": false
      }
    }
    // 複数アプリを扱いたい場合は以下のように追加できます:
    // {
    //   "appId": 222,
    //   "apiToken": "ANOTHER_TOKEN",
    //   "csharp": { "namespace": "KintoneModels.App222" },
    //   "fileWriter": { "outputDirectory": "./Models/App222" }
    // }
  ],

  // Raw メタデータ出力設定の配列（任意）
  "raws": [
    {
      "appId": 222,
      "apiToken": "YOUR_API_TOKEN_HERE",

      // 任意: 出力先ディレクトリ（デフォルト: .）
      "outputDirectory": ".",

      // 任意: 日本語のエスケープを行うか（デフォルト: true）
      "escapeUnicode": false,

      // 任意: ファイルが存在する場合に上書きするか（デフォルト: false）
      "overwriteExistingFiles": false
    }
  ],

  // Diff 設定の配列（任意）
  "diffs": [
    {
      "appId": 333,
      "apiToken": "YOUR_API_TOKEN_HERE",

      // 任意: 出力先ディレクトリ（デフォルト: .）
      "outputDirectory": ".",

      // 任意: ファイルが存在する場合に上書きするか（デフォルト: false）
      "overwriteExistingFiles": false,

      // 任意: 比較対象のベースファイルパス
      "compareWithFile": null,

      // 任意: 出力フォーマット（Text / Json / Markdown）（デフォルト: Text）
      "outputFormat": "Text",

      // 任意: 差分出力ファイル名（{appId} プレースホルダーが使用可能）
      "diffOutputFile": "App333_Diff.txt",

      // 任意: 比較対象ファイルが存在しない場合にエラーにするか（デフォルト: false）
      "failIfNoBaseFile": false,

      // 任意: 日本語のエスケープを行うか（デフォルト: true）
      "escapeUnicode": true
    }
  ]
}
